{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LittlePad",
  "version": "1.2.1",
  "identifier": "com.littlepad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LittlePad",
        "width": 1100,
        "height": 720,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["json", "json5", "jsonc"], "name": "JSON", "role": "Editor" },
      { "ext": ["xml", "xsd", "xsl", "svg", "pom"], "name": "XML", "role": "Editor" },
      { "ext": ["yaml", "yml"], "name": "YAML", "role": "Editor" },
      { "ext": ["toml"], "name": "TOML", "role": "Editor" },
      { "ext": ["ini", "cfg", "conf", "properties"], "name": "Config", "role": "Editor" },
      { "ext": ["log"], "name": "Log", "role": "Editor" },
      { "ext": ["js", "mjs", "cjs", "jsx"], "name": "JavaScript", "role": "Editor" },
      { "ext": ["ts", "tsx"], "name": "TypeScript", "role": "Editor" },
      { "ext": ["java"], "name": "Java", "role": "Editor" },
      { "ext": ["py"], "name": "Python", "role": "Editor" },
      { "ext": ["md", "markdown", "mdx"], "name": "Markdown", "role": "Editor" },
      { "ext": ["txt"], "name": "Plain Text", "role": "Editor" }
    ]
  }
}
